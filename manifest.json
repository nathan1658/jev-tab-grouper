{
  "manifest_version": 3,
  "name": "Jev Tab Grouper",
  "version": "1.0.0",
  "description": "Group tabs by domain, or by category using TypeSafe Jev.",
  "permissions": ["tabs", "tabGroups"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Jev Tab Grouper" }
}
